# --- Stripe ---
# Claves desde https://dashboard.stripe.com/apikeys (usa test para probar, live para cobrar de verdad)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_SECRET_KEY=sk_test_xxx
# Secreto del webhook (Stripe Dashboard > Developers > Webhooks > tu endpoint)
STRIPE_WEBHOOK_SECRET=whsec_xxx

# --- Resend (correo de reservas) ---
# API key desde https://resend.com/api-keys
RESEND_API_KEY=re_xxx
# Remitente. Requiere dominio verificado en Resend para enviar a clientes.
# Para pruebas sin dominio: "Keabelmet <onboarding@resend.dev>" (solo llega a tu propio correo)
RESEND_FROM=Keabelmet <reservas@keabelmet.com>

# --- Instagram (feed existente) ---
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=

# --- Bot de WhatsApp (docs/whatsapp-bot.md) ---
# Claude (https://console.anthropic.com → API Keys)
ANTHROPIC_API_KEY=sk-ant-xxx
# Upstash Redis: se crean solas al conectar "Upstash for Redis" desde el Marketplace de Vercel
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Dualhook (coexistencia con la app de WhatsApp Business): clave dh_live_ y Phone Number ID de la conexión
WHATSAPP_API_BASE=https://api.dualhook.com/v25.0
WHATSAPP_API_TOKEN=dh_live_xxx
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WABA_ID=
# Parte secreta de la URL del webhook (mín. 24 caracteres al azar) y token de verificación
WHATSAPP_WEBHOOK_KEY=
WHATSAPP_VERIFY_TOKEN=
# Contraseña del panel /panel-whatsapp (si falta, usa DEAL_ADMIN_KEY)
WHATSAPP_PANEL_KEY=
