# --- Stripe ---
# Claves desde https://dashboard.stripe.com/apikeys (usa test para probar, live para cobrar de verdad)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_SECRET_KEY=sk_test_xxx
# Secreto del webhook (Stripe Dashboard > Developers > Webhooks > tu endpoint)
STRIPE_WEBHOOK_SECRET=whsec_xxx

# --- Resend (correo de reservas) ---
# API key desde https://resend.com/api-keys
RESEND_API_KEY=re_xxx
# Remitente. Requiere dominio verificado en Resend para enviar a clientes.
# Para pruebas sin dominio: "Keabelmet <onboarding@resend.dev>" (solo llega a tu propio correo)
RESEND_FROM=Keabelmet <reservas@keabelmet.com>

# --- Instagram (feed existente) ---
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=
